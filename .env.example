# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the rotating gate QR tokens (long random string, server only)
QR_TOKEN_SECRET=

# Protects /api/cron/daily (long random string, server only)
CRON_SECRET=
